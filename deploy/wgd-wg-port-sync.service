[Unit]
Description=Reconcile WireDash Docker UDP publication with the live wg0 listen port
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/wg-port-sync.py
TimeoutStartSec=45
NoNewPrivileges=true
